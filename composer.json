{
    "name": "sw-gallery/sw-gallery",
    "description": "sw-gallery - WordPress gallery management, presentation and import (monorepo).",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2",
        "ext-json": "*"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "SWGallery\\Core\\": "packages/core/src/",
            "SWGallery\\WordPress\\": "packages/wordpress/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SWGallery\\Tests\\Support\\": "tests/Support/",
            "SWGallery\\Tests\\Unit\\": "tests/Unit/",
            "SWGallery\\Tests\\Integration\\": "tests/Integration/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "platform": { "php": "8.2.0" }
    },
    "scripts": {
        "test": "phpunit --testsuite unit,integration",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "phpcs --runtime-set ignore_warnings_on_exit 1",
        "cs:fix": "phpcbf",
        "cs:wp": "phpcs --standard=phpcs-wordpress.xml.dist --runtime-set ignore_warnings_on_exit 1",
        "test:coverage": ["@test:coverage:unit", "@test:coverage:wp", "@test:coverage:merge"],
        "test:coverage:unit": "XDEBUG_MODE=coverage phpunit --testsuite unit,integration --coverage-clover coverage/unit.xml",
        "test:coverage:wp": "cd tests/wp && XDEBUG_MODE=coverage vendor/bin/phpunit -c phpunit.xml.dist --coverage-clover ../../coverage/wordpress.xml",
        "test:coverage:merge": "php tests/coverage/merge.php coverage/unit.xml coverage/wordpress.xml && php tests/coverage/check.php coverage/clover.xml",
        "test:wp": "cd tests/wp && vendor/bin/phpunit -c phpunit.xml.dist",
        "test:wp:ms": "cd tests/wp && vendor/bin/phpunit -c phpunit-ms.xml.dist",
        "check": ["@cs", "@cs:wp", "@stan", "@test"]
    }
}
