#: packages/wordpress/src/Admin/AdminRegistrar.php:50
#: packages/wordpress/src/Admin/AdminRegistrar.php:138
msgid "Gallery Management"
msgstr "Galerieverwaltung"

#: packages/wordpress/src/Admin/AdminRegistrar.php:51
#: packages/wordpress/src/PostTypes.php:29
msgid "Galleries"
msgstr "Galerien"

#: packages/wordpress/src/Admin/AdminRegistrar.php:134
msgid "You are not allowed to access this page."
msgstr "Der Zugriff auf diese Seite ist nicht erlaubt."

#: packages/wordpress/src/Admin/AdminRegistrar.php:140
msgid "The gallery admin app is not built. Run \"npm run build\" in apps/admin or install the release package."
msgstr "Die Galerieverwaltung ist nicht gebaut. Führe \"npm run build\" in apps/admin aus oder installiere das Release-Paket."

#: packages/wordpress/src/Admin/AdminRegistrar.php:143
msgid "The gallery administration requires JavaScript."
msgstr "Die Galerieverwaltung benötigt JavaScript."

#: packages/wordpress/src/Cli/RenderCommand.php:65
msgid "The gallery id must be a positive whole number."
msgstr "Die Galerie-ID muss eine positive ganze Zahl sein."

#: packages/wordpress/src/Cli/RenderCommand.php:70
msgid "The entry must be \"shortcode\" or \"feed\"."
msgstr "Der Einstiegspunkt muss \"shortcode\" oder \"feed\" sein."

#: packages/wordpress/src/Cli/RenderCommand.php:75
msgid "The page must be a positive whole number."
msgstr "Die Seite muss eine positive ganze Zahl sein."

#: packages/wordpress/src/Cli/RenderCommand.php:86
msgid "Nothing to render for this gallery and user (not found, not visible or no usable images)."
msgstr "Für diese Galerie und diesen Benutzer gibt es nichts auszugeben (nicht gefunden, nicht sichtbar oder keine nutzbaren Bilder)."

#. translators: 1: smallest batch size, 2: largest batch size
#: packages/wordpress/src/Cli/RepairCommand.php:68
#, php-format
msgid "The batch size must be a whole number from %1$d to %2$d."
msgstr "Die Stapelgröße muss eine ganze Zahl von %1$d bis %2$d sein."

#: packages/wordpress/src/Cli/RepairCommand.php:77
msgid "The format must be \"text\" or \"json\"."
msgstr "Das Format muss \"text\" oder \"json\" sein."

#: packages/wordpress/src/Cli/RepairCommand.php:101
msgid "Mode: apply (problems are removed)."
msgstr "Modus: Anwenden (Probleme werden entfernt)."

#: packages/wordpress/src/Cli/RepairCommand.php:101
msgid "Mode: dry run (nothing is changed)."
msgstr "Modus: Probelauf (es wird nichts geändert)."

#: packages/wordpress/src/Cli/RepairCommand.php:104
msgid "Item relations of a missing gallery"
msgstr "Bildzuordnungen zu einer fehlenden Galerie"

#: packages/wordpress/src/Cli/RepairCommand.php:105
msgid "Item relations of a missing attachment"
msgstr "Bildzuordnungen zu einer fehlenden Mediendatei"

#: packages/wordpress/src/Cli/RepairCommand.php:106
msgid "Covers of a missing attachment"
msgstr "Titelbilder mit fehlender Mediendatei"

#: packages/wordpress/src/Cli/RepairCommand.php:107
msgid "Duplicate item relations"
msgstr "Doppelte Bildzuordnungen"

#. translators: 1: kind of problem, 2: number found, 3: number fixed
#: packages/wordpress/src/Cli/RepairCommand.php:113
#, php-format
msgid "%1$s: %2$d found, %3$d fixed"
msgstr "%1$s: %2$d gefunden, %3$d behoben"

#: packages/wordpress/src/Cli/RepairCommand.php:121
msgid "A safety limit stopped the scan early; run the command again to continue."
msgstr "Eine Sicherheitsgrenze hat die Prüfung vorzeitig beendet; führe den Befehl erneut aus, um fortzufahren."

#: packages/wordpress/src/Cli/RepairCommand.php:124
msgid "No inconsistencies found."
msgstr "Keine Inkonsistenzen gefunden."

#: packages/wordpress/src/Cli/RepairCommand.php:126
msgid "Run again with --apply to remove these problems. Attachments and galleries are never deleted."
msgstr "Mit --apply erneut ausführen, um diese Probleme zu entfernen. Mediendateien und Galerien werden nie gelöscht."

#. translators: %d: number of fixed problems
#: packages/wordpress/src/Cli/RepairCommand.php:131
#, php-format
msgid "%d problem fixed."
msgid_plural "%d problems fixed."
msgstr[0] "%d Problem behoben."
msgstr[1] "%d Probleme behoben."

#: packages/wordpress/src/PostTypes.php:30
msgid "Gallery"
msgstr "Galerie"

#: packages/wordpress/src/Rendering/DiagnosticMarkup.php:36
msgid "Gallery diagnostic (visible to editors only): this gallery does not exist."
msgstr "Galerie-Hinweis (nur für Redakteure sichtbar): Diese Galerie existiert nicht."

#: packages/wordpress/src/Rendering/DiagnosticMarkup.php:38
msgid "Gallery diagnostic (visible to editors only): this gallery is not published, so visitors see nothing here."
msgstr "Galerie-Hinweis (nur für Redakteure sichtbar): Diese Galerie ist nicht veröffentlicht, Besucher sehen hier daher nichts."

#. translators: %s: layout id that is not available
#: packages/wordpress/src/Rendering/DiagnosticMarkup.php:42
#, php-format
msgid "Gallery diagnostic (visible to editors only): the layout \"%s\" is not available, the grid layout is used instead."
msgstr "Galerie-Hinweis (nur für Redakteure sichtbar): Das Layout \"%s\" ist nicht verfügbar, stattdessen wird das Raster-Layout verwendet."

#: packages/wordpress/src/Rendering/DiagnosticMarkup.php:46
msgid "Gallery diagnostic (visible to editors only): the settings of this embed are invalid and were ignored."
msgstr "Galerie-Hinweis (nur für Redakteure sichtbar): Die Einstellungen dieser Einbindung sind ungültig und wurden ignoriert."

#: packages/wordpress/src/Rendering/DiagnosticMarkup.php:48
msgid "Gallery diagnostic (visible to editors only): this gallery has no images yet."
msgstr "Galerie-Hinweis (nur für Redakteure sichtbar): Diese Galerie enthält noch keine Bilder."

#: packages/wordpress/src/Rendering/DiagnosticMarkup.php:54
#, php-format
msgid "Gallery diagnostic (visible to editors only): %d image is missing or unusable and was skipped."
msgid_plural "Gallery diagnostic (visible to editors only): %d images are missing or unusable and were skipped."
msgstr[0] "Galerie-Hinweis (nur für Redakteure sichtbar): %d Bild fehlt oder ist unbrauchbar und wurde übersprungen."
msgstr[1] "Galerie-Hinweis (nur für Redakteure sichtbar): %d Bilder fehlen oder sind unbrauchbar und wurden übersprungen."

#: packages/wordpress/src/Rendering/DiagnosticMarkup.php:62
msgid "Gallery diagnostic (visible to editors only)."
msgstr "Galerie-Hinweis (nur für Redakteure sichtbar)."

#: packages/wordpress/src/Rendering/View/LightboxLabels.php:21
msgid "Image viewer"
msgstr "Bildbetrachter"

#: packages/wordpress/src/Rendering/View/LightboxLabels.php:22
msgid "Close"
msgstr "Schließen"

#: packages/wordpress/src/Rendering/View/LightboxLabels.php:23
msgid "Previous image"
msgstr "Vorheriges Bild"

#: packages/wordpress/src/Rendering/View/LightboxLabels.php:24
msgid "Next image"
msgstr "Nächstes Bild"

#. translators: 1: {current} placeholder, 2: {total} placeholder; keep both placeholders unchanged.
#: packages/wordpress/src/Rendering/View/LightboxLabels.php:26
msgid "{current} of {total}"
msgstr "{current} von {total}"

#: packages/wordpress/src/Rendering/View/LightboxLabels.php:27
msgid "The image could not be loaded."
msgstr "Das Bild konnte nicht geladen werden."

#: packages/wordpress/src/Rest/ErrorMapper.php:52
msgid "The request contains invalid values."
msgstr "Die Anfrage enthält ungültige Werte."

#: packages/wordpress/src/Rest/ErrorMapper.php:131
msgid "An unexpected error occurred."
msgstr "Es ist ein unerwarteter Fehler aufgetreten."

#: packages/wordpress/src/Rest/GalleryController.php:321
msgid "The request does not change anything."
msgstr "Die Anfrage ändert nichts."

#. translators: %s: title of the duplicated gallery
#: packages/wordpress/src/Rest/GalleryController.php:389
#, php-format
msgid "%s (copy)"
msgstr "%s (Kopie)"

#: packages/wordpress/src/Rest/GalleryController.php:602
msgid "The owner does not exist."
msgstr "Der Eigentümer existiert nicht."

#: packages/wordpress/src/Rest/GalleryController.php:610
msgid "The cover must be an image you may use."
msgstr "Das Titelbild muss ein Bild sein, das Sie verwenden dürfen."

#: packages/wordpress/src/Rest/GalleryController.php:635
msgid "You are not allowed to publish galleries."
msgstr "Sie dürfen keine Galerien veröffentlichen."

#: packages/wordpress/src/Support/CoreMessages.php:34
msgid "The gallery is in a state that does not allow this operation."
msgstr "Die Galerie befindet sich in einem Zustand, der diese Aktion nicht erlaubt."

#: packages/wordpress/src/Support/CoreMessages.php:35
msgid "The gallery item was not found."
msgstr "Das Galerie-Element wurde nicht gefunden."

#: packages/wordpress/src/Support/CoreMessages.php:36
msgid "The gallery was changed by someone else."
msgstr "Die Galerie wurde von jemand anderem geändert."

#: packages/wordpress/src/Support/CoreMessages.php:37
msgid "The gallery was not found."
msgstr "Die Galerie wurde nicht gefunden."

#: packages/wordpress/src/Support/CoreMessages.php:38
msgid "The import provider reported an error."
msgstr "Der Import-Anbieter hat einen Fehler gemeldet."

#: packages/wordpress/src/Support/CoreMessages.php:39
msgid "The layout is not registered."
msgstr "Das Layout ist nicht registriert."

#: packages/wordpress/src/Support/CoreMessages.php:40
msgid "The operation was prevented by an extension."
msgstr "Die Aktion wurde von einer Erweiterung verhindert."

#: packages/wordpress/src/Support/CoreMessages.php:41
msgid "The order must contain every item of the gallery exactly once."
msgstr "Die Reihenfolge muss jedes Element der Galerie genau einmal enthalten."

#: packages/wordpress/src/Support/CoreMessages.php:42
msgid "The settings are invalid."
msgstr "Die Einstellungen sind ungültig."

#: packages/wordpress/src/Support/CoreMessages.php:43
msgid "You are not allowed to do this."
msgstr "Dazu fehlt die Berechtigung."

#. translators: 1: required PHP version, 2: current PHP version
#: sw-gallery.php:36
#, php-format
msgid "sw-gallery requires PHP %1$s or newer. You are running PHP %2$s."
msgstr "sw-gallery benötigt PHP %1$s oder neuer. Es läuft PHP %2$s."

#: sw-gallery.php:55
msgid "sw-gallery: the vendor directory is missing. Install the release package or run \"composer install\"."
msgstr "sw-gallery: Das Verzeichnis vendor fehlt. Installiere das Release-Paket oder führe „composer install“ aus."
