#: packages/wordpress/src/Update/Service.php:51
msgid "Update checks are only allowed in an authorised backend session."
msgstr "Update-Prüfungen sind nur in einer berechtigten Backend-Sitzung erlaubt."

#: packages/wordpress/src/Update/Service.php:54
msgid "Public release key, Sodium or ZIP support is missing. GitHub updates are blocked."
msgstr "Öffentlicher Release-Schlüssel, Sodium oder ZIP-Unterstützung fehlt. GitHub-Updates sind gesperrt."

#: packages/wordpress/src/Update/Service.php:58
msgid "An update check is already running."
msgstr "Eine Update-Prüfung läuft bereits."

#: packages/wordpress/src/Update/Service.php:64
msgid "The last update check is still within the check interval."
msgstr "Die letzte Update-Prüfung liegt noch innerhalb des Prüfintervalls."

#: packages/wordpress/src/Update/Service.php:71
msgid "The check took too long. The result was not adopted."
msgstr "Die Prüfung dauerte zu lange. Das Ergebnis wurde nicht übernommen."

#: packages/wordpress/src/Update/Service.php:79
msgid "Signed release information verified. Install updates only through the WordPress plugin list."
msgstr "Signierte Release-Informationen geprüft. Installation ausschließlich über die Plugin-Verwaltung von WordPress."

#: packages/wordpress/src/Update/Service.php:81
msgid "Invalid release response."
msgstr "Ungültige Release-Antwort."

#: packages/wordpress/src/Update/Service.php:103
msgid "No valid stable release response."
msgstr "Keine gültige stabile Release-Antwort."

#: packages/wordpress/src/Update/Service.php:112
msgid "Release manifest or signature is missing."
msgstr "Release-Manifest oder Signatur fehlt."

#: packages/wordpress/src/Update/Service.php:128
msgid "An already verified newer version must not be rolled back."
msgstr "Eine bereits geprüfte neuere Version darf nicht zurückgenommen werden."

#: packages/wordpress/src/Update/Service.php:150
msgid "Please check for updates again before installing."
msgstr "Bitte vor der Installation die Updates erneut prüfen."

#: packages/wordpress/src/Update/Service.php:157
msgid "Outdated release offer."
msgstr "Veraltetes Release-Angebot."

#: packages/wordpress/src/Update/Service.php:178
msgid "Package, version or system requirements do not match."
msgstr "Paket, Version oder Systemvoraussetzungen stimmen nicht."

#: packages/wordpress/src/Update/Service.php:186
msgid "Temporary update file unavailable."
msgstr "Temporäre Update-Datei nicht verfügbar."

#: packages/wordpress/src/Update/Transport.php:27
msgid "Update address not allowed."
msgstr "Nicht erlaubte Update-Adresse."

#: packages/wordpress/src/Update/Transport.php:47
msgid "GitHub could not be reached."
msgstr "GitHub konnte nicht erreicht werden."

#: packages/wordpress/src/Update/Transport.php:53
msgid "Invalid redirect."
msgstr "Ungültige Weiterleitung."

#. translators: %d: HTTP status code
#: packages/wordpress/src/Update/Transport.php:60
#, php-format
msgid "GitHub responded with HTTP %d."
msgstr "GitHub-Antwort: HTTP %d."

#: packages/wordpress/src/Update/Transport.php:68
msgid "The update response exceeds the size limit."
msgstr "Die Update-Antwort überschreitet das Größenlimit."

#: packages/wordpress/src/Update/Transport.php:72
msgid "Too many update redirects."
msgstr "Zu viele Update-Weiterleitungen."

#. translators: 1: required PHP version, 2: current PHP version
#: sw-gallery.php:37
#, php-format
msgid "sw-gallery requires PHP %1$s or newer. You are running PHP %2$s."
msgstr "sw-gallery benötigt PHP %1$s oder neuer. Es läuft PHP %2$s."

#: sw-gallery.php:56
msgid "sw-gallery: the vendor directory is missing. Install the release package or run \"composer install\"."
msgstr "sw-gallery: Das Verzeichnis vendor fehlt. Installiere das Release-Paket oder führe „composer install“ aus."

#~ msgid "The owner does not exist."
#~ msgstr "Der Eigentümer existiert nicht."
