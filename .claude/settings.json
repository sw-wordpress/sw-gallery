{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/rebuild-on-change.sh",
            "timeout": 180,
            "statusMessage": "Rebuilding frontend assets if sources changed..."
          }
        ]
      }
    ]
  }
}
