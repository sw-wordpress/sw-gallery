{
  "name": "sw-gallery-assets",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "sw-gallery public frontend assets (accessible lightbox; vanilla TypeScript, no runtime dependencies)",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "Safari >= 16",
    "last 2 iOS versions"
  ],
  "scripts": {
    "build": "tsc --noEmit && node scripts/build-all.mjs && node scripts/check-build.mjs",
    "build:only": "node scripts/build-all.mjs",
    "build:watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/check-coverage.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.0.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.0.5"
  }
}
