{
  "name": "sw-gallery-blocks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "sw-gallery Gutenberg block glue (minimal TypeScript; @wordpress/* come from the wp.* globals at runtime)",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/check-build.mjs",
    "build:only": "vite build",
    "build:watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/check-coverage.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@wordpress/api-fetch": "^8.1.0",
    "@wordpress/block-editor": "^20.0.0",
    "@wordpress/blocks": "^17.1.0",
    "@wordpress/components": "^44.0.0",
    "@wordpress/element": "^10.1.0",
    "@wordpress/i18n": "^7.1.0",
    "@wordpress/server-side-render": "^7.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
