parameters:
    level: 8
    paths:
        - packages/core/src
        - packages/wordpress/src
        - sw-gallery.php
        - uninstall.php
    bootstrapFiles:
        - tests/phpstan/bootstrap.php
    dynamicConstantNames:
        - SWGALLERY_VERSION
        - SWGALLERY_MIN_PHP
    tmpDir: .phpstan.cache
